EVALUATE
FILTER (
    SUMMARIZECOLUMNS (
        'Calender'[Year],
        "Sales", [Total Sales],
        "Cost", [Total Cost],
        "Profit", [Total Profit],
        "ProfitPct", [Total Profit %],
        "SalesLY", [Sales LY],
        "ProfitLY", [Profit LY],
        "Customers", [Total Customers],
        "NewCustomers", [New Customer],
        "Ratings", [Customer Rating Count]
    ),
    NOT ISBLANK ( [Sales] )
)
ORDER BY 'Calender'[Year]
